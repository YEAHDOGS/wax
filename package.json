{
  "name": "wax",
  "private": true,
  "version": "0.1.0",
  "description": "Wax — real-time vinyl drop alerts, collection cataloguing, and Discogs price tracking. made by DOGS.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "npm run dev --workspace @wax/web",
    "build": "npm run build --workspace @wax/web",
    "preview": "npm run preview --workspace @wax/web"
  }
}
